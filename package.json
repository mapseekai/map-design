{
  "name": "map-design",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "description": "MapDesign is a local-first cartographic workspace for map creation and exploration.",
  "license": "Apache-2.0",
  "bin": {
    "md": "./apps/daemon/bin/md.mjs"
  },
  "scripts": {
    "postinstall": "node ./scripts/postinstall.mjs",
    "tools-dev": "pnpm exec tools-dev",
    "tools-pack": "pnpm exec tools-pack",
    "lint": "pnpm lint:shadcn",
    "lint:shadcn": "eslint --no-inline-config apps/web/src apps/web/app packages/components/src",
    "guard": "pnpm guard:mapdesign-imports && tsx ./scripts/guard.ts",
    "guard:mapdesign-imports": "tsx scripts/check-mapdesign-imports.ts",
    "typecheck": "pnpm -r --workspace-concurrency=4 --if-present run typecheck && tsc -p scripts/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@mapseekai/components": "workspace:*",
    "@mapseekai/daemon": "workspace:*",
    "@mapseekai/tools-dev": "workspace:*",
    "@mapseekai/tools-pack": "workspace:*",
    "@shadcn/lint": "0.1.1",
    "@types/node": "20.19.39",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.11.0",
    "tsx": "4.22.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "~24",
    "pnpm": ">=10.33.2 <11"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "devalue": "5.8.1",
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "postcss": "8.5.15",
      "protobufjs": "8.4.0",
      "qs": "6.15.2",
      "tar": "7.5.22",
      "tmp": "0.2.7",
      "undici@^6": "6.28.0",
      "undici@^7": "7.29.0",
      "yaml": "2.9.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "core-js",
      "electron",
      "electron-winstaller",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  }
}
